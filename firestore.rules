rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to items collection
    match /items/{itemId} {
      allow read, write: if true;
    }
    
    // Allow read/write access to users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Allow read/write access to payment history collection
    match /paymentHistory/{entryId} {
      allow read, write: if true;
    }

    // Allow read/write access to FCM push token registrations
    match /pushTokens/{tokenId} {
      allow read, write: if true;
    }

    // Allow read/write access to aircondUsage collection
    match /aircondUsage/{usageId} {
      allow read, write: if true;
    }

    // Allow read/write access to rentalExpenses collection
    match /rentalExpenses/{expenseId} {
      allow read, write: if true;
    }

    // The first client that opens a new deployed build publishes its release event.
    match /appUpdates/{updateId} {
      allow read, write: if true;
    }
  }
}
